PORT=3000
# Extra browser origins allowed to call the API; localhost, *.vercel.app and ngrok are always allowed
# Where uploads are staged; falls back to the system temp dir when the project folder is read-only
UPLOAD_DIR=
ALLOWED_ORIGINS=

MONGO_URI=mongodb://localhost:27017/factlayer

AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

VECTOR_DB_PROVIDER=pinecone
PINECONE_API_KEY=your-pinecone-api-key
# Created automatically with EMBEDDING_DIMENSION if it does not exist
PINECONE_INDEX_NAME=factlayer
PINECONE_NAMESPACE=factlayer
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# MiniMax (OpenAI-compatible chat completions + embeddings)
MINIMAX_API_KEY=your-minimax-api-key
GEMINI_API_KEY=your-gemini-api-key
MINIMAX_API_BASE=https://api.minimax.io/v1
# Preferred LLM provider; the other is used automatically while this one is rate limited
# How long a single call keeps cycling providers while both are rate limited before giving up
LLM_RATE_LIMIT_BUDGET_MS=300000
LLM_PROVIDER=minimax
FACT_EXTRACTION_MODEL=MiniMax-M3
GEMINI_MODEL=gemini-2.5-flash
# Optional pacing for per-minute rate limits; 0 disables
EXTRACTION_REQUESTS_PER_MINUTE=0
# Parallel chunk extractions per document
EXTRACTION_CONCURRENCY=12
# Documents processed at the same time inside the server process
PROCESSING_CONCURRENCY=2
# Parallel Pinecone similarity queries while matching facts across documents
MATCHING_CONCURRENCY=8

# pinecone (hosted llama-text-embed-v2, dimension configurable) or minimax (embo-01, 1536 dims, needs embeddings quota)
EMBEDDING_PROVIDER=pinecone
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2
MINIMAX_EMBEDDING_MODEL=embo-01
EMBEDDING_DIMENSION=1024

# Per-workspace rate limits for the model-backed endpoints
ASK_RATE_MAX=10
ASK_RATE_WINDOW_MS=60000
UPLOAD_RATE_MAX=10
UPLOAD_RATE_WINDOW_MS=60000
